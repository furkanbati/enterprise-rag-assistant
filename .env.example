# Copy to .env and uncomment the settings you want to change.
# Every setting is optional; the defaults below match config.py.

# --- Providers ---------------------------------------------------------
# "ollama" (local) or "openai". The chat provider can be switched at any
# time. Switching the embedding provider or model needs the documents to be
# uploaded again, because each embedding model gets its own collection.
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=ollama

# Defaults depend on the provider:
#   ollama: llama3 / nomic-embed-text
#   openai: gpt-6-luna / text-embedding-3-small
# CHAT_MODEL=llama3
# EMBED_MODEL=nomic-embed-text

# OLLAMA_HOST=http://ollama:11434

# Required when a provider is "openai". Never commit a real key.
# OPENAI_API_KEY=
# Point the OpenAI client at another OpenAI-compatible API.
# OPENAI_BASE_URL=
# Reasoning effort for OpenAI reasoning models. Leave empty to not send it.
# OPENAI_REASONING_EFFORT=low

# Model that grades answers in the evaluation (python -m evaluation --judge).
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-6.1-sol

# --- Retrieval and chunking ---------------------------------------------
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# CHROMA_PATH=./data/chroma
# COLLECTION_NAME=documents

# FINAL_TOP_K=3
# RETRIEVAL_TOP_K=12

# "sentence" packs whole sentences up to the size limits; "semantic" also
# splits where the topic shifts. Each chunking configuration gets its own
# collection; upload the documents again after switching.
# CHUNKING_STRATEGY=sentence
# Prefix every chunk with the document title.
# CHUNK_CONTEXT=true
# Semantic only: split at boundaries above this percentile of embedding
# distances in the document, comparing windows of +/- SEMANTIC_WINDOW sentences.
# SEMANTIC_PERCENTILE=90
# SEMANTIC_WINDOW=1
# MAX_CHUNK_SIZE=1000
# MIN_CHUNK_SIZE=300

# --- OCR -----------------------------------------------------------------
# Engine for PDFs without a text layer: "rapidocr", "easyocr" or "off".
# On two scanned pages RapidOCR took about 9 s per page and EasyOCR about
# 27 s. Documents indexed earlier are not read again after switching.
# OCR_ENGINE=rapidocr
