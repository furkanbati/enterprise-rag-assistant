# Copy to .env and uncomment the settings you want to change.
# Every setting is optional; the defaults below match config.py.

# --- Providers ---------------------------------------------------------
# "ollama" (local) or "openai". The chat provider can be switched at any
# time. Switching the embedding provider or model needs the documents to be
# uploaded again, because each embedding model gets its own collection.
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=ollama

# Defaults depend on the provider:
#   ollama: llama3 / nomic-embed-text
#   openai: gpt-6-luna / text-embedding-3-small
# CHAT_MODEL=llama3
# EMBED_MODEL=nomic-embed-text

# OLLAMA_HOST=http://ollama:11434

# Required when a provider is "openai". Never commit a real key.
# OPENAI_API_KEY=
# Point the OpenAI client at another OpenAI-compatible API.
# OPENAI_BASE_URL=
# Reasoning effort for OpenAI reasoning models. Leave empty to not send it.
# OPENAI_REASONING_EFFORT=low

# --- Retrieval and chunking ---------------------------------------------
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# CHROMA_PATH=./data/chroma
# COLLECTION_NAME=documents

# FINAL_TOP_K=3
# RETRIEVAL_TOP_K=12

# Each chunking strategy gets its own collection; upload the documents again
# after switching.
# CHUNKING_STRATEGY=sentence
# MAX_CHUNK_SIZE=1000
# MIN_CHUNK_SIZE=300
