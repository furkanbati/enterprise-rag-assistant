# syntax=docker/dockerfile:1.7

# The API image plus the RAGAS evaluation packages; see the "eval" service
# in docker-compose.yml.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# RAGAS sends usage analytics unless this is set.
ENV RAGAS_DO_NOT_TRACK=true

COPY requirements.txt requirements-eval.txt requirements-eval-overrides.txt ./

# uv applies the version overrides in requirements-eval-overrides.txt, which
# pip cannot do.
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/uv \
    pip install --upgrade pip \
    && pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install uv==0.13.6 \
    && uv pip install --system \
        -r requirements.txt \
        -r requirements-eval.txt \
        --override requirements-eval-overrides.txt

RUN python -c "from rapidocr import RapidOCR; RapidOCR()"

COPY . .

CMD ["python", "-m", "evaluation.ragas_eval", "--help"]
